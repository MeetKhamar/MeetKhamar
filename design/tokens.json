{
  "meta": {
    "version": "1.0.0",
    "project": "CyberSOC Profile Dashboard",
    "author": "Meet Khamar"
  },
  "color": {
    "background": {
      "primary": "#0D1117",
      "secondary": "#161B22",
      "tertiary": "#1C2333",
      "card": "#13171F",
      "glass": "rgba(139, 92, 246, 0.06)"
    },
    "brand": {
      "purple": "#8B5CF6",
      "purpleLight": "#A78BFA",
      "purpleDark": "#7C3AED",
      "purpleGlow": "rgba(139, 92, 246, 0.35)",
      "purpleMuted": "#6D28D9"
    },
    "accent": {
      "gold": "#F59E0B",
      "goldLight": "#FBBF24",
      "goldGlow": "rgba(245, 158, 11, 0.25)",
      "white": "#F1F5F9",
      "slate": "#94A3B8",
      "slateDark": "#64748B",
      "slateLight": "#CBD5E1"
    },
    "status": {
      "success": "#10B981",
      "successGlow": "rgba(16, 185, 129, 0.3)",
      "warning": "#F59E0B",
      "warningGlow": "rgba(245, 158, 11, 0.3)",
      "critical": "#EF4444",
      "criticalGlow": "rgba(239, 68, 68, 0.3)",
      "info": "#3B82F6",
      "infoGlow": "rgba(59, 130, 246, 0.3)"
    },
    "border": {
      "default": "rgba(139, 92, 246, 0.15)",
      "hover": "rgba(139, 92, 246, 0.35)",
      "subtle": "rgba(148, 163, 184, 0.1)"
    }
  },
  "spacing": {
    "unit": 4,
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48,
    "section": 64
  },
  "radius": {
    "sm": 6,
    "md": 10,
    "lg": 16,
    "xl": 24,
    "pill": 999
  },
  "typography": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif",
    "fontMono": "'SF Mono', 'Fira Code', 'Cascadia Code', Consolas, monospace",
    "sizes": {
      "hero": 28,
      "h1": 22,
      "h2": 18,
      "h3": 15,
      "body": 13,
      "caption": 11,
      "micro": 9
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.75
    }
  },
  "animation": {
    "duration": {
      "fast": "0.3s",
      "normal": "0.6s",
      "slow": "1.2s",
      "pulse": "3s",
      "float": "6s",
      "scan": "8s",
      "radar": "4s",
      "breathe": "5s"
    },
    "easing": {
      "default": "cubic-bezier(0.4, 0, 0.2, 1)",
      "smooth": "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
      "bounce": "cubic-bezier(0.68, -0.55, 0.265, 1.55)"
    }
  },
  "effects": {
    "glow": {
      "purple": "0 0 20px rgba(139, 92, 246, 0.25)",
      "gold": "0 0 12px rgba(245, 158, 11, 0.2)",
      "success": "0 0 10px rgba(16, 185, 129, 0.3)"
    },
    "glass": {
      "background": "rgba(13, 17, 23, 0.7)",
      "blur": "12px",
      "border": "1px solid rgba(139, 92, 246, 0.12)"
    },
    "shadow": {
      "sm": "0 2px 8px rgba(0, 0, 0, 0.3)",
      "md": "0 4px 16px rgba(0, 0, 0, 0.4)",
      "lg": "0 8px 32px rgba(0, 0, 0, 0.5)"
    }
  }
}
